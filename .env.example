# Runtime — copy to a local, non-committed .env and replace every placeholder.
# Generate the two secrets, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# For docker-compose.prod.yml set ENVIRONMENT=production, generate fresh JWT_SECRET and
# METRICS_TOKEN values, use a postgresql:// DATABASE_URL and https:// CORS origins;
# the application refuses to start in production with any placeholder or insecure value.
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Use SQLite only for a local demo; production requires PostgreSQL.
DATABASE_URL=sqlite:///./processtwin.db
# Production two-role posture (required for enforced tenant RLS): DATABASE_URL
# must be the NON-OWNER application role, DATABASE_ADMIN_URL the table owner
# used only by the `migrate` service. Provision the app role before the first
# migration so default privileges cover all tables it creates:
#   psql "$DATABASE_ADMIN_URL" -v app_role=processtwin_app \
#     -v app_password='...' -f scripts/postgres_app_role.sql
# Optional: when unset, migrations run as DATABASE_URL and RLS stays dormant.
# DATABASE_ADMIN_URL=postgresql+psycopg://owner:...@host:5432/processtwin
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10
JWT_SECRET=REPLACE_WITH_A_RANDOM_32_CHARACTER_MINIMUM_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=processtwin-api
JWT_AUDIENCE=processtwin-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
METRICS_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_32_CHARACTER_MINIMUM_TOKEN
MAX_UPLOAD_BYTES=5000000
MAX_REQUEST_BYTES=5256000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=10

# Demo-only. Leave unset in production; seed_demo refuses to run without both values.
DEMO_EMAIL=engineer@processtwin.demo
DEMO_PASSWORD=REPLACE_WITH_A_LOCAL_DEMO_PASSWORD

# Object storage for dataset artifacts. Leave MINIO_ENDPOINT empty to disable object
# storage (imports then stay in the database); set all four values to enable it.
MINIO_ENDPOINT=
MINIO_BUCKET=processtwin
MINIO_SECURE=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Public origin of the dashboard, required by docker-compose.prod.yml.
NEXT_PUBLIC_API_URL=http://localhost:8000

# External services (optional adapters; never hard-code secrets)
REDIS_URL=redis://redis:6379/0
MQTT_BROKER_URL=mqtt://mosquitto:1883
OPCUA_ENDPOINT=
MLFLOW_URL=http://mlflow:5000
# Optional model-registry metadata mirror; requires `pip install -e ".[mlflow]"`.
MLFLOW_TRACKING_URI=

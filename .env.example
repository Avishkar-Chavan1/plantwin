# Runtime — copy to a local, non-committed .env and replace every placeholder.
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Use SQLite only for a local demo; production requires PostgreSQL.
DATABASE_URL=sqlite:///./processtwin.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10
JWT_SECRET=REPLACE_WITH_A_RANDOM_32_CHARACTER_MINIMUM_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=processtwin-api
JWT_AUDIENCE=processtwin-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
METRICS_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_32_CHARACTER_MINIMUM_TOKEN
MAX_UPLOAD_BYTES=5000000
MAX_REQUEST_BYTES=5256000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=10

# Demo-only. Leave unset in production; seed_demo refuses to run without both values.
DEMO_EMAIL=engineer@processtwin.demo
DEMO_PASSWORD=REPLACE_WITH_A_LOCAL_DEMO_PASSWORD

# External services (optional adapters; never hard-code secrets)
REDIS_URL=redis://redis:6379/0
MQTT_BROKER_URL=mqtt://mosquitto:1883
OPCUA_ENDPOINT=
S3_ENDPOINT=http://minio:9000
S3_BUCKET=processtwin
MLFLOW_URL=http://mlflow:5000
# Optional model-registry metadata mirror; requires `pip install -e ".[mlflow]"`.
MLFLOW_TRACKING_URI=

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Use SQLite for a zero-dependency local run; Docker uses PostgreSQL.
DATABASE_URL=sqlite:///./processtwin.db
JWT_SECRET=replace-with-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEMO_EMAIL=engineer@processtwin.demo
DEMO_PASSWORD=ChangeMeDemoOnly!

# External services (optional adapters; never hard-code secrets)
REDIS_URL=redis://redis:6379/0
MQTT_BROKER_URL=mqtt://mosquitto:1883
OPCUA_ENDPOINT=
S3_ENDPOINT=http://minio:9000
S3_BUCKET=processtwin
MLFLOW_URL=http://mlflow:5000

